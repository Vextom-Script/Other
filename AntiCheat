local fullscreenShown = false

local function showFullscreen(text)
	if fullscreenShown then return end
	fullscreenShown = true
	overlayLabel.Text = text
	overlay.Visible = true
	task.delay(FULLSCREEN_DURATION, function()
		overlay.Visible = false
	end)
end

local listed = {}
local raw = fetch(LIST_URL)
if raw then
	listed = parseList(raw)
else
	print("[UserWarning] Could not fetch the list (pattern check still active).")
end

local function refresh(leavingPlayer)
	local found = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and plr ~= leavingPlayer then
			local flagged = listed[plr.Name:lower()]
				or listed[plr.DisplayName:lower()]
				or isSuspiciousName(plr.Name)
				or isSuspiciousName(plr.DisplayName)
			if flagged then
				table.insert(found, plr.Name)
			end
		end
	end

	if #found > 0 then
		local text = "Exploiters:\n" .. table.concat(found, "\n")
		label.Text = text
		frame.Visible = true
		return text
	else
		label.Text = ""
		frame.Visible = false
		return nil
	end
end

Players.PlayerAdded:Connect(function()
	task.defer(refresh)
end)

Players.PlayerRemoving:Connect(function(plr)
	refresh(plr) 
end)

local initialText = refresh()
if initialText then
	showFullscreen(initialText)
end
