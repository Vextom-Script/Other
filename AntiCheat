local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local CoreGui = game:GetService("CoreGui")

local LIST_URL = "https://raw.githubusercontent.com/Vextom-Script/Vextom/refs/heads/Base/CheckerList"
local localPlayer = Players.LocalPlayer

local MIN_PATTERN_LENGTH = 4
local MIN_EMBEDDED_LENGTH = 5
local FULLSCREEN_DURATION = 5

local function fetch(url)
	local ok, res = pcall(function()
		return game:HttpGet(url)
	end)
	if ok and type(res) == "string" then return res end

	local req = (syn and syn.request) or http_request or request
	if req then
		local ok2, r = pcall(req, { Url = url, Method = "GET" })
		if ok2 and r and r.Body then return r.Body end
	end

	local ok3, res3 = pcall(function()
		return HttpService:GetAsync(url)
	end)
	if ok3 then return res3 end

	return nil
end

local function parseList(raw)
	local set = {}
	for line in string.gmatch(raw, "[^\r\n]+") do
		local name = line:match("^%s*(.-)%s*$")
		if name ~= "" then
			set[name:lower()] = true
		end
	end
	return set
end

local function isSuspiciousName(name)
	if type(name) ~= "string" then
		return false
	end
	local lowered = name:lower()
	local pureName = not lowered:find("[^il]")

	for run in lowered:gmatch("[il]+") do
		local needed = (pureName and MIN_PATTERN_LENGTH) or MIN_EMBEDDED_LENGTH
		if #run >= needed and run:find("i") and run:find("l") then
			return true
		end
	end
	return false
end

